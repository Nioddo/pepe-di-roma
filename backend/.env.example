# Copiá este archivo como ".env" (en esta misma carpeta), completalo y reiniciá el servidor.
# El ".env" no se sube al repositorio: guarda la contraseña de la casilla.

PORT=3000

# ---------- Correo: la casilla desde la que salen los mails a los clientes ----------
# Con Gmail: activá la verificación en dos pasos en la cuenta y creá una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# (es una clave de 16 letras; la contraseña normal de la cuenta no sirve).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Cómo aparece el remitente. Si queda vacío se usa SMTP_USER.
# Ejemplo: MAIL_FROM="Pepe Di Roma <la-casilla-del-local>"
MAIL_FROM=

# Otros proveedores: cambiá SMTP_HOST y SMTP_PORT por los suyos (587 con STARTTLS o 465 con TLS).
# Outlook / Microsoft 365: smtp.office365.com · 587
# Brevo:                   smtp-relay.brevo.com · 587
