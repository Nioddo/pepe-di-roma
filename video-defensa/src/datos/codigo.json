{"backend/src/routes/reservaRoutes.js":["const express = require('express');","const ReservaController = require('../controllers/ReservaController');","const { requireLogin, creaParaSiMismo, reservaPropia } = require('../middlewares/auth');","","const router = express.Router();","","router.get('/', ReservaController.obtenerTodas);","router.get('/:id', reservaPropia, ReservaController.obtenerPorId);","router.post('/', requireLogin, creaParaSiMismo, ReservaController.crear);","router.put('/:id', reservaPropia, ReservaController.modificar);","router.delete('/:id', reservaPropia, ReservaController.eliminar);","","module.exports = router;",""],"backend/src/middlewares/auth.js":["const UsuarioRepository = require('../repositories/UsuarioRepository');","const ReservaRepository = require('../repositories/ReservaRepository');","const PedidoRepository = require('../repositories/PedidoRepository');","const Rol = require('../enums/Rol');","const Messages = require('../enums/Messages');","const { UnauthorizedError, ForbiddenError } = require('../exceptions/AppError');","","const ES_PERSONAL = [Rol.ADMIN, Rol.EMPLEADO];","","function identificar(req, res, next) {","    const id = Number(req.get('x-usuario-id'));","    req.usuario = Number.isInteger(id) && id > 0 ? UsuarioRepository.findById(id) : null;","    next();","}","","function requireLogin(req, res, next) {","    if (!req.usuario) {","        return next(new UnauthorizedError(Messages.AUTH_REQUERIDA));","    }","    next();","}","","function requireRol(roles) {","    return function (req, res, next) {","        if (!req.usuario) {","            return next(new UnauthorizedError(Messages.AUTH_REQUERIDA));","        }","        if (!roles.includes(req.usuario.rol)) {","            return next(new ForbiddenError(Messages.AUTH_SIN_PERMISO));","        }","        next();","    };","}","","const requirePersonal = requireRol(ES_PERSONAL);","const requireAdmin = requireRol([Rol.ADMIN]);","","function esPersonal(usuario) {","    return Boolean(usuario) && ES_PERSONAL.includes(usuario.rol);","}","","function soloPropio(buscarPorId) {","    return function (req, res, next) {","        if (esPersonal(req.usuario)) {","            return next();","        }","        const registro = buscarPorId(Number(req.params.id));","        const cambiaDuenio = req.body && req.body.clienteId !== undefined && Number(req.body.clienteId) !== req.usuario.id;","        if ((registro && registro.clienteId !== req.usuario.id) || cambiaDuenio) {","            return next(new ForbiddenError(Messages.AUTH_SIN_PERMISO));","        }","        next();","    };","}","","function creaParaSiMismo(req, res, next) {","    if (!esPersonal(req.usuario) && req.body && Number(req.body.clienteId) !== req.usuario.id) {","        return next(new ForbiddenError(Messages.AUTH_SIN_PERMISO));","    }","    next();","}","","const reservaPropia = [requireLogin, soloPropio((id) => ReservaRepository.findById(id))];","const pedidoPropio = [requireLogin, soloPropio((id) => PedidoRepository.findById(id))];","","module.exports = {","    identificar,","    requireLogin,","    requirePersonal,","    requireAdmin,","    esPersonal,","    creaParaSiMismo,","    reservaPropia,","    pedidoPropio","};",""],"backend/src/controllers/ReservaController.js":["const ReservaService = require('../services/ReservaService');","const { successResponse } = require('../responses/apiResponse');","const { asyncHandler } = require('../utils/asyncHandler');","","const obtenerTodas = asyncHandler((req, res) => {","    const reservas = ReservaService.obtenerTodas(req.usuario);","    return successResponse(res, reservas);","});","","const obtenerPorId = asyncHandler((req, res) => {","    const reserva = ReservaService.obtenerPorId(req.params.id);","    return successResponse(res, reserva);","});","","const crear = asyncHandler((req, res) => {","    const reserva = ReservaService.crear(req.body);","    return successResponse(res, reserva, 201);","});","","const modificar = asyncHandler((req, res) => {","    const reserva = ReservaService.modificar(req.params.id, req.body);","    return successResponse(res, reserva);","});","","const eliminar = asyncHandler((req, res) => {","    const reserva = ReservaService.eliminar(req.params.id);","    return successResponse(res, reserva);","});","","module.exports = {","    obtenerTodas,","    obtenerPorId,","    crear,","    modificar,","    eliminar","};",""],"backend/src/services/ReservaService.js":["const ReservaRepository = require('../repositories/ReservaRepository');","const MesaRepository = require('../repositories/MesaRepository');","const UsuarioRepository = require('../repositories/UsuarioRepository');","const Messages = require('../enums/Messages');","const EstadoReserva = require('../enums/EstadoReserva');","const Rol = require('../enums/Rol');","const { telefonoValido } = require('../utils/telefono');","const { BadRequestError, NotFoundError, ConflictError } = require('../exceptions/AppError');","","const DURACION_MIN = 120;","const MAX_ELIGE_MESA = 4;","const MAX_ONLINE = 12;","","const FORMATO_FECHA = /^\\d{4}-\\d{2}-\\d{2}$/;","const FORMATO_HORA = /^([01]\\d|2[0-3]):([0-5]\\d)$/;","","function parsearId(id) {","    const numero = Number(id);","    if (!Number.isInteger(numero) || numero <= 0) {","        throw new BadRequestError(Messages.INVALID_ID);","    }","    return numero;","}","","function validarClienteId(clienteId) {","    const numero = Number(clienteId);","    if (!Number.isInteger(numero) || numero <= 0) {","        throw new BadRequestError(Messages.RESERVA_CLIENTE_REQUIRED);","    }","","    if (!UsuarioRepository.findById(numero)) {","        throw new NotFoundError(Messages.USUARIO_NOT_FOUND);","    }","","    return numero;","}","","function validarFecha(fecha) {","    if (typeof fecha !== 'string' || !FORMATO_FECHA.test(fecha)) {","        throw new BadRequestError(Messages.RESERVA_FECHA_INVALID);","    }","","    const [anio, mes, dia] = fecha.split('-').map(Number);","    const parseada = new Date(Date.UTC(anio, mes - 1, dia));","","    const esFechaReal =","        parseada.getUTCFullYear() === anio &&","        parseada.getUTCMonth() === mes - 1 &&","        parseada.getUTCDate() === dia;","","    if (!esFechaReal) {","        throw new BadRequestError(Messages.RESERVA_FECHA_INVALID);","    }","","    return fecha;","}","","function validarHora(horaInicio) {","    if (typeof horaInicio !== 'string' || !FORMATO_HORA.test(horaInicio)) {","        throw new BadRequestError(Messages.RESERVA_HORA_INVALID);","    }","    return horaInicio;","}","","function validarIntegrantes(cantidad) {","    const numero = Number(cantidad);","    if (!Number.isInteger(numero) || numero <= 0) {","        throw new BadRequestError(Messages.RESERVA_INTEGRANTES_INVALID);","    }","    if (numero > MAX_ONLINE) {","        throw new BadRequestError(Messages.RESERVA_GRUPO_EXCEDIDO);","    }","    return numero;","}","","function validarEstado(estado) {","    if (!Object.values(EstadoReserva).includes(estado)) {","        throw new BadRequestError(Messages.RESERVA_ESTADO_INVALID);","    }","    return estado;","}","","function obtenerMesa(mesaId) {","    const numero = Number(mesaId);","    if (!Number.isInteger(numero) || numero <= 0) {","        throw new BadRequestError(Messages.MESA_NOT_FOUND);","    }","","    const mesa = MesaRepository.findById(numero);","    if (!mesa) {","        throw new NotFoundError(Messages.MESA_NOT_FOUND);","    }","","    return mesa;","}","","function validarMesaSegunGrupo(mesaId, cantidadIntegrantes) {","    const sinMesa = mesaId === null || mesaId === undefined;","","    if (cantidadIntegrantes <= MAX_ELIGE_MESA) {","        if (sinMesa) {","            throw new BadRequestError(Messages.RESERVA_MESA_REQUERIDA);","        }","        const mesa = obtenerMesa(mesaId);","        if (mesa.capacidad < cantidadIntegrantes) {","            throw new ConflictError(Messages.MESA_CAPACIDAD_INSUFICIENTE);","        }","        return mesa.id;","    }","","    return sinMesa ? null : obtenerMesa(mesaId).id;","}","","function aMinutos(hora) {","    const [horas, minutos] = hora.split(':').map(Number);","    return horas * 60 + minutos;","}","","function validarDisponibilidad({ mesaId, fecha, horaInicio, idAExcluir = null }) {","    const inicio = aMinutos(horaInicio);","    const fin = inicio + DURACION_MIN;","","    const seSolapa = ReservaRepository.findByMesaAndFecha(mesaId, fecha).some((reserva) => {","        if (reserva.id === idAExcluir || reserva.estado === EstadoReserva.CANCELADA) {","            return false;","        }","","        const inicioExistente = aMinutos(reserva.horaInicio);","        const finExistente = inicioExistente + (reserva.duracionMin || DURACION_MIN);","","        return inicio < finExistente && inicioExistente < fin;","    });","","    if (seSolapa) {","        throw new ConflictError(Messages.RESERVA_MESA_OCUPADA);","    }","}","","function ocultarDatosPersonales(reserva) {","    return { ...reserva, clienteId: null, nombre: null, telefono: null };","}","","// El personal ve todo; el resto solo ve sus datos y, de las demas, lo necesario para saber que mesa esta ocupada.","function obtenerTodas(solicitante = null) {","    const reservas = ReservaRepository.findAll();","    if (solicitante && (solicitante.rol === Rol.ADMIN || solicitante.rol === Rol.EMPLEADO)) {","        return reservas;","    }","    return reservas.map((reserva) =>","        solicitante && reserva.clienteId === solicitante.id ? reserva : ocultarDatosPersonales(reserva)","    );","}","","function obtenerPorId(id) {","    const reservaId = parsearId(id);","    const reserva = ReservaRepository.findById(reservaId);","","    if (!reserva) {","        throw new NotFoundError(Messages.RESERVA_NOT_FOUND);","    }","","    return reserva;","}","","function validarNombre(nombre) {","    if (typeof nombre !== 'string' || !nombre.trim() || nombre.trim().length > 60) {","        throw new BadRequestError(Messages.RESERVA_NOMBRE_REQUIRED);","    }","    return nombre.trim();","}","","function validarTelefonoReserva(telefono) {","    if (!telefonoValido(telefono)) {","        throw new BadRequestError(Messages.RESERVA_TELEFONO_INVALID);","    }","    return telefono.trim();","}","","function crear(body) {","    if (!body || typeof body !== 'object') {","        throw new BadRequestError(Messages.INVALID_DATA);","    }","","    const clienteId = validarClienteId(body.clienteId);","    const fecha = validarFecha(body.fecha);","    const horaInicio = validarHora(body.horaInicio);","    const cantidadIntegrantes = validarIntegrantes(body.cantidadIntegrantes);","    const mesaId = validarMesaSegunGrupo(body.mesaId, cantidadIntegrantes);","    const estado = body.estado === undefined ? EstadoReserva.PENDIENTE : validarEstado(body.estado);","    const nombre = validarNombre(body.nombre);","    const telefono = validarTelefonoReserva(body.telefono);","","    if (mesaId !== null) {","        validarDisponibilidad({ mesaId, fecha, horaInicio });","    }","","    return ReservaRepository.create({","        clienteId,","        fecha,","        horaInicio,","        cantidadIntegrantes,","        mesaId,","        estado,","        nombre,","        telefono","    });","}","","function modificar(id, body) {","    const reserva = obtenerPorId(id);","","    if (!body || typeof body !== 'object') {","        throw new BadRequestError(Messages.INVALID_DATA);","    }","","    const cambios = {};","","    if (body.clienteId !== undefined) {","        cambios.clienteId = validarClienteId(body.clienteId);","    }","    if (body.fecha !== undefined) {","        cambios.fecha = validarFecha(body.fecha);","    }","    if (body.horaInicio !== undefined) {","        cambios.horaInicio = validarHora(body.horaInicio);","    }","    if (body.cantidadIntegrantes !== undefined) {","        cambios.cantidadIntegrantes = validarIntegrantes(body.cantidadIntegrantes);","    }","    if (body.mesaId !== undefined) {","        cambios.mesaId = body.mesaId;","    }","    if (body.estado !== undefined) {","        cambios.estado = validarEstado(body.estado);","    }","    if (body.nombre !== undefined) {","        cambios.nombre = validarNombre(body.nombre);","    }","    if (body.telefono !== undefined) {","        cambios.telefono = validarTelefonoReserva(body.telefono);","    }","","    const resultado = Object.assign({}, reserva, cambios);","    resultado.mesaId = validarMesaSegunGrupo(resultado.mesaId, resultado.cantidadIntegrantes);","    if (cambios.mesaId !== undefined || cambios.cantidadIntegrantes !== undefined) {","        cambios.mesaId = resultado.mesaId;","    }","","    if (resultado.estado !== EstadoReserva.CANCELADA && resultado.mesaId !== null) {","        validarDisponibilidad({","            mesaId: resultado.mesaId,","            fecha: resultado.fecha,","            horaInicio: resultado.horaInicio,","            idAExcluir: reserva.id","        });","    }","","    return ReservaRepository.update(reserva.id, cambios);","}","","function eliminar(id) {","    const reserva = obtenerPorId(id);","    return ReservaRepository.remove(reserva.id);","}","","module.exports = {","    obtenerTodas,","    obtenerPorId,","    crear,","    modificar,","    eliminar","};",""],"backend/src/repositories/ReservaRepository.js":["const Reserva = require('../models/Reserva');","const EstadoReserva = require('../enums/EstadoReserva');","const { createIdGenerator } = require('../utils/idGenerator');","const historial = require('../data/historialSeed');","","const reservas = [","    new Reserva(1, 1, '2026-10-24', '21:00', 2, 1, EstadoReserva.CONFIRMADA, 'Cliente de prueba', '+54 9 11 5000-1234'),","    new Reserva(2, 2, '2026-10-24', '21:00', 4, 2, EstadoReserva.PENDIENTE, 'Martín Pérez', '+54 9 11 6021-7788'),","    new Reserva(3, 1, '2026-10-31', '20:30', 8, null, EstadoReserva.PENDIENTE, 'Cliente de prueba', '+54 9 11 5000-1234'),","    ...historial.reservas.map(","        (r) => new Reserva(r.id, r.clienteId, r.fecha, r.horaInicio, r.cantidadIntegrantes, r.mesaId, r.estado, r.nombre, r.telefono)","    )","];","","const nextId = createIdGenerator(Math.max(...reservas.map((r) => r.id)) + 1);","","function findAll() {","    return reservas;","}","","function findById(id) {","    return reservas.find((reserva) => reserva.id === id) || null;","}","","function findByMesaAndFecha(mesaId, fecha) {","    return reservas.filter((reserva) => reserva.mesaId === mesaId && reserva.fecha === fecha);","}","","function findByMesaId(mesaId) {","    return reservas.filter((reserva) => reserva.mesaId === mesaId);","}","","function findByClienteId(clienteId) {","    return reservas.filter((reserva) => reserva.clienteId === clienteId);","}","","function create(datos) {","    const reserva = new Reserva(","        nextId(),","        datos.clienteId,","        datos.fecha,","        datos.horaInicio,","        datos.cantidadIntegrantes,","        datos.mesaId,","        datos.estado,","        datos.nombre,","        datos.telefono","    );","","    reservas.push(reserva);","    return reserva;","}","","function update(id, datos) {","    const reserva = findById(id);","    if (!reserva) {","        return null;","    }","","    Object.assign(reserva, datos);","    return reserva;","}","","function remove(id) {","    const indice = reservas.findIndex((reserva) => reserva.id === id);","    if (indice === -1) {","        return null;","    }","","    const [eliminada] = reservas.splice(indice, 1);","    return eliminada;","}","","module.exports = {","    findAll,","    findById,","    findByMesaAndFecha,","    findByMesaId,","    findByClienteId,","    create,","    update,","    remove","};",""],"backend/src/enums/Messages.js":["const Messages = Object.freeze({","    INVALID_DATA: 'Los datos enviados no son validos',","    INVALID_ID: 'El ID indicado no es valido',","    DUPLICATED_RESOURCE: 'El recurso ya existe',","    INTERNAL_ERROR: 'Ocurrio un error inesperado en el servidor',","    ROUTE_NOT_FOUND: 'La ruta solicitada no existe',","","    USUARIO_NOT_FOUND: 'El usuario solicitado no existe',","    USUARIO_EMAIL_INVALID: 'El email del usuario no es valido',","    USUARIO_EMAIL_DUPLICATED: 'Ya existe un usuario con ese email',","    USUARIO_DNI_INVALID: 'El DNI debe tener 7 u 8 digitos numericos',","    USUARIO_DNI_DUPLICATED: 'Ya existe un usuario con ese DNI',","    USUARIO_ROL_INVALID: 'El rol del usuario no es valido',","    USUARIO_CON_REFERENCIAS: 'No se puede eliminar un usuario con reservas, pedidos o calificaciones asociadas',","","    SECCION_NOT_FOUND: 'La seccion solicitada no existe',","    SECCION_TITULO_REQUIRED: 'El titulo de la seccion es obligatorio',","    SECCION_DUPLICATED: 'Ya existe una seccion con ese titulo en esa carta',","    SECCION_CARTA_INVALID: 'La carta de la seccion no es valida',","    SECCION_TEXTO_INVALID: 'El grupo, el subtitulo y la nota de la seccion deben ser textos',","    SECCION_ORDEN_INVALID: 'El orden de la seccion debe ser un entero mayor a 0',","    SECCION_PLATOS_INVALID: 'Los platos de la seccion deben ser una lista de IDs sin repetir',","","    PLATO_NOT_FOUND: 'El plato solicitado no existe',","    PLATO_DUPLICATED: 'Ya existe un plato con ese nombre',","    PLATO_NOMBRE_REQUIRED: 'El nombre del plato es obligatorio',","    PLATO_PRECIO_INVALID: 'El precio del plato debe ser un numero entero mayor a 0',","    PLATO_FLAG_INVALID: 'Los campos vegano, sinTacc, picante y destacado deben ser booleanos',","    PLATO_TEXTO_INVALID: 'La descripcion y la medida del plato deben ser textos',","    PLATO_IMAGE_INVALID: 'La imageUrl debe ser un texto',","    PLATO_EN_SECCION: 'No se puede eliminar un plato que pertenece a una seccion',","","    MESA_NOT_FOUND: 'La mesa indicada no existe',","    MESA_NUMERO_INVALID: 'El numero de mesa debe ser un entero mayor a 0',","    MESA_DUPLICATED: 'Ya existe una mesa con ese numero',","    MESA_CAPACIDAD_INVALID: 'La capacidad de la mesa debe ser un entero mayor a 0',","    MESA_POSICION_INVALID: 'Las posiciones X e Y de la mesa deben ser numeros',","    MESA_CAPACIDAD_INSUFICIENTE: 'La mesa no tiene capacidad para esa cantidad de integrantes',","    MESA_CON_RESERVAS: 'No se puede eliminar una mesa con reservas activas',","","    RESERVA_NOT_FOUND: 'La reserva solicitada no existe',","    RESERVA_CLIENTE_REQUIRED: 'El clienteId es obligatorio',","    RESERVA_FECHA_INVALID: 'La fecha debe tener el formato YYYY-MM-DD',","    RESERVA_HORA_INVALID: 'La hora de inicio debe tener el formato HH:MM',","    RESERVA_INTEGRANTES_INVALID: 'La cantidad de integrantes debe ser un entero mayor a 0',","    RESERVA_ESTADO_INVALID: 'El estado de la reserva no es valido',","    RESERVA_MESA_OCUPADA: 'La mesa ya esta reservada en ese horario',","    RESERVA_MESA_REQUERIDA: 'Las reservas de hasta 4 personas deben elegir una mesa',","    RESERVA_NOMBRE_REQUIRED: 'El nombre de quien reserva es obligatorio (hasta 60 caracteres)',","    RESERVA_TELEFONO_INVALID: 'El telefono debe tener entre 8 y 15 numeros',","    RESERVA_GRUPO_EXCEDIDO: 'Las reservas de mas de 12 personas no se pueden hacer online',","","    PEDIDO_NOT_FOUND: 'El pedido solicitado no existe',","    PEDIDO_CLIENTE_REQUIRED: 'El clienteId es obligatorio',","    PEDIDO_MODALIDAD_INVALID: 'La modalidad del pedido no es valida',","    PEDIDO_METODO_PAGO_INVALID: 'El metodo de pago no es valido',","    PEDIDO_ESTADO_INVALID: 'El estado del pedido no es valido',","    PEDIDO_DIRECCION_REQUIRED: 'La direccion es obligatoria para los pedidos con delivery',","    PEDIDO_ITEMS_REQUIRED: 'El pedido debe tener al menos un item',","    PEDIDO_ITEM_INVALID: 'Cada item debe tener un platoId valido y una cantidad mayor a 0',","    PEDIDO_TELEFONO_INVALID: 'El telefono debe tener entre 8 y 15 numeros',","    PEDIDO_INDICACIONES_INVALID: 'Las indicaciones deben ser un texto de hasta 300 caracteres',","    PEDIDO_NOMBRE_REQUIRED: 'El nombre de quien retira es obligatorio (hasta 60 caracteres)',","    PEDIDO_HORA_RETIRO_INVALID: 'La hora de retiro debe tener el formato HH:MM',","    PEDIDO_SOLO_CLIENTES: 'El personal del local no puede hacer pedidos desde la web',","    PEDIDO_PAGO_INVALID: 'El campo pagoRecibido debe ser booleano',","","    CONTENIDO_NOT_FOUND: 'El contenido solicitado no existe',","    CONTENIDO_CLAVE_REQUIRED: 'La clave del contenido es obligatoria',","    CONTENIDO_VALOR_INVALID: 'El valor del contenido debe ser un texto',","    CONTENIDO_DUPLICATED: 'Ya existe un contenido con esa clave',","","    CALIFICACION_NOT_FOUND: 'La calificacion solicitada no existe',","    CALIFICACION_PUNTAJE_INVALID: 'El puntaje debe ser un entero entre 1 y 5',","    CALIFICACION_MENSAJE_REQUIRED: 'El mensaje de la calificacion es obligatorio',","    CALIFICACION_MENSAJE_LARGO: 'El mensaje no puede superar los 500 caracteres',","    CALIFICACION_FIRMA_INVALID: 'La firma es obligatoria y no puede superar los 40 caracteres',","    CALIFICACION_FECHA_INVALID: 'La fecha debe tener el formato YYYY-MM-DD',","    CALIFICACION_MOZO_INVALID: 'El nombre de quien te atendió no puede superar los 40 caracteres',","    CALIFICACION_VISIBLE_INVALID: 'El campo visible debe ser booleano',","    CALIFICACION_RESPUESTA_INVALID: 'La respuesta debe ser un texto de hasta 500 caracteres',","","    PROMOCION_ASUNTO_INVALID: 'El asunto es obligatorio y no puede superar los 120 caracteres',","    PROMOCION_MENSAJE_INVALID: 'El mensaje es obligatorio y no puede superar los 5000 caracteres',","    PROMOCION_TITULO_INVALID: 'El titulo no puede superar los 120 caracteres',","    PROMOCION_IMAGEN_INVALID: 'La imagen tiene que ser un link que empiece con https://',","    PROMOCION_BOTON_INVALID: 'El boton necesita un texto (hasta 40 caracteres) y un link que empiece con https://',","    PROMOCION_SIN_DESTINATARIOS: 'No hay cuentas registradas a las que enviar el mensaje',","    PROMOCION_MAIL_NO_CONFIGURADO: 'El envio de mails no esta configurado: completar MAIL_HOST, MAIL_USER y MAIL_PASS en backend/.env',","    PROMOCION_ENVIO_FALLIDO: 'No se pudo enviar ningun mail. Revisa la configuracion del servidor de correo',","","    AUTH_REQUERIDA: 'Hace falta iniciar sesion para realizar esta accion',","    AUTH_SIN_PERMISO: 'No tenes permiso para realizar esta accion',","    AUTH_CREDENCIALES_INVALID: 'El email o el DNI no son correctos',","    AUTH_ROL_RESERVADO: 'Solo un administrador puede crear cuentas de empleado o administrador',","","    ITEM_PEDIDO_NOT_FOUND: 'El item de pedido solicitado no existe',","    ITEM_PEDIDO_PEDIDO_REQUIRED: 'El pedidoId es obligatorio',","    ITEM_PEDIDO_PEDIDO_INMUTABLE: 'Un item no se puede mover a otro pedido',","    ITEM_PEDIDO_CANTIDAD_INVALID: 'La cantidad del item debe ser un entero mayor a 0',","    ITEM_PEDIDO_ULTIMO: 'No se puede eliminar el unico item de un pedido'","});","","module.exports = Messages;",""],"backend/src/middlewares/errorHandler.js":["const { AppError } = require('../exceptions/AppError');","const { errorResponse } = require('../responses/apiResponse');","const Messages = require('../enums/Messages');","","function errorHandler(err, req, res, next) {","    if (err instanceof AppError) {","        return errorResponse(res, err.message, err.statusCode);","    }","","    if (err instanceof SyntaxError && err.status === 400 && 'body' in err) {","        return errorResponse(res, Messages.INVALID_DATA, 400);","    }","","    console.error('[ERROR NO CONTROLADO]', err);","    return errorResponse(res, Messages.INTERNAL_ERROR, 500);","}","","module.exports = errorHandler;",""],"backend/src/exceptions/AppError.js":["class AppError extends Error {","    constructor(message, statusCode = 500) {","        super(message);","        this.name = this.constructor.name;","        this.statusCode = statusCode;","        this.isOperational = true;","        Error.captureStackTrace(this, this.constructor);","    }","}","","class BadRequestError extends AppError {","    constructor(message) {","        super(message, 400);","    }","}","","class UnauthorizedError extends AppError {","    constructor(message) {","        super(message, 401);","    }","}","","class NotFoundError extends AppError {","    constructor(message) {","        super(message, 404);","    }","}","","class ForbiddenError extends AppError {","    constructor(message) {","        super(message, 403);","    }","}","","class ConflictError extends AppError {","    constructor(message) {","        super(message, 409);","    }","}","","class ServiceUnavailableError extends AppError {","    constructor(message) {","        super(message, 503);","    }","}","","module.exports = {","    AppError,","    BadRequestError,","    UnauthorizedError,","    NotFoundError,","    ConflictError,","    ForbiddenError,","    ServiceUnavailableError","};",""],"frontend/src/services/api.ts":["// Cliente HTTP único. Todos los servicios pasan por acá: configura la URL,","// procesa la respuesta { success, data | message } del backend y lanza un","// ApiError legible cuando algo falla.","","import { leerSesion } from '../utils/sesion';","","const API_URL: string = import.meta.env.VITE_API_URL ?? '/api';","","const SIN_CONEXION =","  'No pudimos conectar con el servidor. Revisá que el backend esté corriendo en el puerto 3000.';","","export class ApiError extends Error {","  readonly status: number;","","  constructor(message: string, status: number) {","    super(message);","    this.name = 'ApiError';","    this.status = status;","  }","}","","interface RespuestaOk<T> {","  success: true;","  data: T;","}","","interface RespuestaError {","  success: false;","  message: string;","}","","type RespuestaApi<T> = RespuestaOk<T> | RespuestaError;","","// Cada pedido lleva quién es el usuario con sesión; el backend decide qué puede hacer según su rol.","function identidad(): Record<string, string> {","  const usuario = leerSesion();","  return usuario ? { 'x-usuario-id': String(usuario.id) } : {};","}","","async function request<T>(path: string, options: RequestInit = {}): Promise<T> {","  let response: Response;","","  try {","    response = await fetch(`${API_URL}${path}`, {","      cache: 'no-store',","      ...options,","      headers: {","        'Content-Type': 'application/json',","        ...identidad(),","        ...options.headers","      }","    });","  } catch {","    throw new ApiError(SIN_CONEXION, 0);","  }","","  let body: RespuestaApi<T> | null = null;","  try {","    body = (await response.json()) as RespuestaApi<T>;","  } catch {","    body = null;","  }","","  if (!response.ok || !body || !body.success) {","    const message = body && !body.success ? body.message : `Error ${response.status} del servidor.`;","    throw new ApiError(message, response.status);","  }","","  return body.data;","}","","export const api = {","  get: <T>(path: string) => request<T>(path),","  post: <T>(path: string, data: unknown) =>","    request<T>(path, { method: 'POST', body: JSON.stringify(data) }),","  put: <T>(path: string, data: unknown) =>","    request<T>(path, { method: 'PUT', body: JSON.stringify(data) }),","  delete: <T>(path: string) => request<T>(path, { method: 'DELETE' })","};","","export function mensajeDeError(error: unknown): string {","  if (error instanceof Error && error.message) return error.message;","  return 'Ocurrió un error inesperado.';","}",""],"frontend/src/services/reservasService.ts":["import { api } from './api';","import type { EstadoReserva, Reserva, ReservaInput } from '../types';","","const RUTA = '/reservas';","","export function getReservas(): Promise<Reserva[]> {","  return api.get<Reserva[]>(RUTA);","}","","export function getReserva(id: number): Promise<Reserva> {","  return api.get<Reserva>(`${RUTA}/${id}`);","}","","export async function getReservasDeCliente(clienteId: number): Promise<Reserva[]> {","  const reservas = await getReservas();","  return reservas.filter((r) => r.clienteId === clienteId);","}","","export function createReserva(datos: ReservaInput): Promise<Reserva> {","  return api.post<Reserva>(RUTA, datos);","}","","export function updateReserva(id: number, cambios: Partial<ReservaInput>): Promise<Reserva> {","  return api.put<Reserva>(`${RUTA}/${id}`, cambios);","}","","export function cambiarEstadoReserva(id: number, estado: EstadoReserva): Promise<Reserva> {","  return api.put<Reserva>(`${RUTA}/${id}`, { estado });","}","","export function deleteReserva(id: number): Promise<Reserva> {","  return api.delete<Reserva>(`${RUTA}/${id}`);","}",""],"frontend/src/pages/Reserve/Reserve.tsx":["import { useMemo } from 'react';","import { useParams } from 'react-router-dom';","import { useAuth } from '../../context/AuthContext';","import { useContenido } from '../../context/ContenidoContext';","import { useApi } from '../../hooks/useApi';","import { getMesas } from '../../services/mesasService';","import { getReservas } from '../../services/reservasService';","import { esPersonal } from '../../utils/sesion';","import { PageHeader } from '../../components/PageHeader/PageHeader';","import { Button, ButtonLink } from '../../components/Button/Button';","import { EmptyState } from '../../components/EmptyState/EmptyState';","import { Loading, SkeletonBlock } from '../../components/Skeleton/Skeleton';","import { ReserveForm } from './ReserveForm';","import './Reserve.css';","","const cargarDatos = () => Promise.all([getMesas(), getReservas()]);","","/** Carga el salón y las reservas; el formulario recién se arma con los datos listos. */","export function Reserve() {","  const { id } = useParams();","  const editId = id ? Number(id) : undefined;","  const { usuario } = useAuth();","  const BAJADA = useContenido().texto('reservar.bajada');","  const { data, loading, error, recargar } = useApi(cargarDatos);","","  const mesas = useMemo(() => (data ? [...data[0]].sort((a, b) => a.numero - b.numero) : []), [data]);","  const reservas = data?.[1] ?? [];","  const editando = editId ? reservas.find((r) => r.id === editId) : undefined;","  const titulo = editId ? 'Modificar reserva' : 'Reservá tu mesa';","","  if (loading) {","    return (","      <>","        <PageHeader title={titulo} lead={BAJADA} />","        <div className=\"wrap page\">","          <Loading label=\"Cargando el salón…\">","            <div className=\"split\">","              <SkeletonBlock height={360} />","              <SkeletonBlock height={420} />","            </div>","          </Loading>","        </div>","      </>","    );","  }","","  if (error || !usuario) {","    return (","      <>","        <PageHeader title={titulo} lead={BAJADA} />","        <div className=\"wrap page\">","          <EmptyState","            title=\"No pudimos cargar el salón\"","            text={error ?? 'Volvé a intentarlo en un momento.'}","            action={<Button onClick={recargar}>Reintentar</Button>}","          />","        </div>","      </>","    );","  }","","  const ajena = editando && editando.clienteId !== usuario.id && !esPersonal(usuario);","  if (editId && (!editando || ajena || editando.estado === 'CANCELADA')) {","    return (","      <>","        <PageHeader title={titulo} />","        <div className=\"wrap page\">","          <EmptyState","            title=\"No encontramos esa reserva\"","            text=\"Puede que se haya cancelado o que no sea tuya.\"","            action={<ButtonLink to=\"/mis-reservas\">Ver mis reservas</ButtonLink>}","          />","        </div>","      </>","    );","  }","","  return (","    <>","      <PageHeader title={titulo} lead={BAJADA} />","      <div className=\"wrap page\">","        <ReserveForm","          key={editando?.id ?? 'nueva'}","          usuario={usuario}","          mesas={mesas}","          reservas={reservas}","          editando={editando}","          onError={recargar}","        />","      </div>","    </>","  );","}",""],"frontend/src/pages/Reserve/ReserveForm.tsx":["import { useRef, useState, type FormEvent } from 'react';","import { useNavigate } from 'react-router-dom';","import { useToast } from '../../context/ToastContext';","import { createReserva, updateReserva } from '../../services/reservasService';","import { mensajeDeError } from '../../services/api';","import { formatearFecha, hoyISO } from '../../utils/formato';","import { horarios, MAX_ONLINE, mesaOcupada, reglaPara } from '../../utils/reservas';","import { hayErrores, validarRequerido, validarTelefono, type Errores } from '../../utils/validacion';","import { enfocarPrimerError } from '../../utils/foco';","import { useContacto } from '../../hooks/useSitio';","import { InlineError, SelectField, TextField } from '../../components/Field/Field';","import { Notice } from '../../components/Notice/Notice';","import { Button, ButtonLink } from '../../components/Button/Button';","import { TableLegend, TableMap, type EstadoMesa } from '../../components/TableMap/TableMap';","import { EmptyState } from '../../components/EmptyState/EmptyState';","import type { Mesa, Reserva, Usuario } from '../../types';","","type Campo = 'fecha' | 'hora' | 'mesa' | 'nombre' | 'telefono';","","const OPCIONES_INTEGRANTES = [","  ...Array.from({ length: MAX_ONLINE }, (_, i) => ({","    value: String(i + 1),","    label: `${i + 1} ${i === 0 ? 'persona' : 'personas'}`","  })),","  { value: String(MAX_ONLINE + 1), label: `Más de ${MAX_ONLINE}` }","];","","","interface ReserveFormProps {","  usuario: Usuario;","  mesas: Mesa[];","  reservas: Reserva[];","  editando?: Reserva;","  onError: () => void;","}","","/**"," * Regla del local:"," *  - hasta 4 personas eligen la mesa en el mapa;"," *  - de 5 a 12 no eligen: el local asigna la mesa libre más chica que alcance;"," *  - más de 12 no pueden reservar online."," */","export function ReserveForm({ usuario, mesas, reservas, editando, onError }: ReserveFormProps) {","  const toast = useToast();","  const navigate = useNavigate();","  const formRef = useRef<HTMLFormElement>(null);","  const mapaRef = useRef<HTMLDivElement>(null);","  const contacto = useContacto();","","  const [fecha, setFecha] = useState(editando?.fecha ?? hoyISO());","  const [hora, setHora] = useState(editando?.horaInicio ?? '');","  const [integrantes, setIntegrantes] = useState(editando?.cantidadIntegrantes ?? 2);","  // para no volver a escribirlo: se sugiere el nombre y el teléfono de la última reserva del cliente","  const ultima = reservas.filter((r) => r.clienteId === usuario.id && r.nombre).sort((a, b) => b.id - a.id)[0];","  const [nombre, setNombre] = useState(editando?.nombre ?? ultima?.nombre ?? '');","  const [telefono, setTelefono] = useState(editando?.telefono ?? ultima?.telefono ?? '');","  const [mesaId, setMesaId] = useState<number | null>(","    editando && reglaPara(editando.cantidadIntegrantes) === 'elige-mesa' ? editando.mesaId : null","  );","  const [errores, setErrores] = useState<Errores<Campo>>({});","  const [enviando, setEnviando] = useState(false);","","  const regla = reglaPara(integrantes);","  const excluir = editando?.id;","","  const estadoDe = (mesa: Mesa): EstadoMesa => {","    if (regla !== 'elige-mesa' || !fecha || !hora) return 'bloqueada';","    if (mesaOcupada(mesa.id, fecha, hora, reservas, excluir)) return 'ocupada';","    if (mesa.capacidad < integrantes) return 'bloqueada';","    return mesa.id === mesaId ? 'elegida' : 'libre';","  };","","  const limpiar = (campo: Campo) => setErrores((e) => ({ ...e, [campo]: '' }));","","  const cambiarIntegrantes = (valor: number) => {","    setIntegrantes(valor);","    const elegida = mesas.find((m) => m.id === mesaId);","    if (reglaPara(valor) !== 'elige-mesa' || (elegida && elegida.capacidad < valor)) setMesaId(null);","    limpiar('mesa');","  };","","  const enviar = async (evento: FormEvent) => {","    evento.preventDefault();","    if (regla === 'no-online') return;","","    const nuevos: Errores<Campo> = {","      fecha: !fecha ? 'Elegí una fecha.' : !editando && fecha < hoyISO() ? 'Elegí una fecha de hoy en adelante.' : '',","      hora: hora ? '' : 'Elegí un horario.',","      mesa: regla === 'elige-mesa' && fecha && hora && !mesaId ? 'Elegí una mesa disponible en el mapa.' : '',","      nombre: validarRequerido(nombre, 'Decinos a nombre de quién va la reserva.'),","      telefono: validarTelefono(telefono)","    };","","    setErrores(nuevos);","    if (hayErrores(nuevos)) {","      if (nuevos.fecha || nuevos.hora || nuevos.nombre || nuevos.telefono) enfocarPrimerError(formRef.current);","      else mapaRef.current?.querySelector<HTMLElement>('[data-estado=\"libre\"]')?.focus();","      return;","    }","","    // de 5 a 12 personas la reserva viaja sin mesa: la asigna el local desde Gestión de reservas","    const mesaFinal = regla === 'elige-mesa' ? mesaId : null;","    const numero = mesas.find((m) => m.id === mesaFinal)?.numero;","    const cuando = `${formatearFecha(fecha)} a las ${hora} h`;","    const datos = { fecha, horaInicio: hora, cantidadIntegrantes: integrantes, mesaId: mesaFinal, nombre: nombre.trim(), telefono: telefono.trim() };","","    setEnviando(true);","    try {","      if (editando) {","        await updateReserva(editando.id, datos);","        toast.success(`Guardaste los cambios: ${cuando}${numero ? `, mesa ${numero}` : ''}.`);","      } else {","        await createReserva({ clienteId: usuario.id, ...datos });","        toast.success(","          regla === 'asigna-local'","            ? `Listo: reservaste para ${integrantes} personas el ${cuando}. El local te va a asignar la mesa.`","            : `Listo: reservaste la mesa ${numero} para el ${cuando}.`","        );","      }","      navigate('/mis-reservas');","    } catch (err) {","      toast.error(mensajeDeError(err));","      onError();","    } finally {","      setEnviando(false);","    }","  };","","  let notaMapa = 'Tocá una mesa disponible para elegirla.';","  if (!fecha || !hora) notaMapa = 'Elegí fecha y horario para ver qué mesas están libres.';","  else if (regla === 'asigna-local') notaMapa = 'Para grupos de 5 a 12 personas el mapa queda bloqueado: la mesa la asigna el local.';","  else if (regla === 'no-online') notaMapa = 'El mapa queda bloqueado: los grupos de más de 12 reservan por WhatsApp.';","","  return (","    <div className=\"split\">","      <form ref={formRef} onSubmit={enviar} noValidate className=\"panel-form reveal\">","        {editando && (","          <Notice>","            Estás modificando la reserva del <strong>{formatearFecha(editando.fecha)} a las {editando.horaInicio} h</strong>.","          </Notice>","        )}","","        <div className=\"form-row\">","          <TextField","            label=\"Fecha\"","            type=\"date\"","            min={editando ? undefined : hoyISO()}","            value={fecha}","            error={errores.fecha}","            onChange={(e) => {","              setFecha(e.target.value);","              // si el nuevo día cierra antes, el horario elegido puede quedar afuera","              if (hora && !horarios(e.target.value).includes(hora)) setHora('');","              setMesaId(null);","              limpiar('fecha');","            }}","          />","          <SelectField","            label=\"Horario\"","            options={[{ value: '', label: 'Elegí un horario' }, ...horarios(fecha).map((h) => ({ value: h, label: `${h} h` }))]}","            value={hora}","            error={errores.hora}","            onChange={(e) => {","              setHora(e.target.value);","              setMesaId(null);","              limpiar('hora');","            }}","          />","        </div>","","        <div className=\"form-row\">","          <TextField","            label=\"A nombre de\"","            autoComplete=\"name\"","            maxLength={60}","            value={nombre}","            error={errores.nombre}","            onChange={(e) => {","              setNombre(e.target.value);","              limpiar('nombre');","            }}","          />","          <TextField","            label=\"Teléfono\"","            type=\"tel\"","            inputMode=\"tel\"","            autoComplete=\"tel\"","            hint=\"Para avisarte si cambia algo.\"","            value={telefono}","            error={errores.telefono}","            onChange={(e) => {","              setTelefono(e.target.value);","              limpiar('telefono');","            }}","          />","        </div>","","        <SelectField","          label=\"Integrantes\"","          options={OPCIONES_INTEGRANTES}","          value={String(integrantes)}","          onChange={(e) => cambiarIntegrantes(Number(e.target.value))}","        />","","        {regla === 'asigna-local' && (","          <Notice tono=\"info\">","            <strong>Grupos de 5 a 12 personas no eligen mesa.</strong> El local te la asigna y la vas a ver en Mis reservas.","          </Notice>","        )}","        {regla === 'no-online' && (","          <Notice tono=\"stop\">","            <strong>Más de {MAX_ONLINE} personas no pueden reservar online.</strong> Escribinos por{' '}","            <a href={contacto.whatsappHref} target=\"_blank\" rel=\"noopener noreferrer\">","              WhatsApp al {contacto.telefono}","            </a>{' '}","            y lo coordinamos.","          </Notice>","        )}","","        <Button type=\"submit\" block loading={enviando} disabled={regla === 'no-online'}>","          {editando ? 'Guardar cambios' : 'Confirmar reserva'}","        </Button>","        {editando && (","          <ButtonLink to=\"/mis-reservas\" variant=\"ghost\" block className=\"reserve__discard\">","            Descartar cambios","          </ButtonLink>","        )}","      </form>","","      <section className=\"panel salon reveal\" aria-labelledby=\"salon-titulo\">","        <div className=\"salon__head\">","          <h2 id=\"salon-titulo\">Mapa del salón</h2>","          <TableLegend />","        </div>","","        {mesas.length === 0 ? (","          <EmptyState title=\"El salón no tiene mesas\" text=\"Todavía no hay mesas cargadas en el sistema.\" />","        ) : (","          <div ref={mapaRef}>","            <TableMap","              mesas={mesas}","              estadoDe={estadoDe}","              onElegir={(mesa) => {","                setMesaId((actual) => (actual === mesa.id ? null : mesa.id));","                limpiar('mesa');","              }}","            />","          </div>","        )}","","        <p className=\"salon__note\">{notaMapa}</p>","        {errores.mesa && <InlineError>{errores.mesa}</InlineError>}","      </section>","    </div>","  );","}",""],"frontend/src/pages/MyReservations/MyReservations.tsx":["import { useState } from 'react';","import { useAuth } from '../../context/AuthContext';","import { useToast } from '../../context/ToastContext';","import { useConfirm } from '../../context/ConfirmContext';","import { useApi } from '../../hooks/useApi';","import { getMesas } from '../../services/mesasService';","import { cambiarEstadoReserva, getReservasDeCliente } from '../../services/reservasService';","import { mensajeDeError } from '../../services/api';","import { aMinutos, deMinutos, diaDe, formatearFecha, mesDe, plural } from '../../utils/formato';","import { ESTADO_RESERVA } from '../../utils/estados';","import { PageHeader } from '../../components/PageHeader/PageHeader';","import { RecordCard, RecordList } from '../../components/RecordCard/RecordCard';","import { Badge } from '../../components/Badge/Badge';","import { Button, ButtonLink } from '../../components/Button/Button';","import { EmptyState } from '../../components/EmptyState/EmptyState';","import { SkeletonList } from '../../components/Skeleton/Skeleton';","import type { Reserva } from '../../types';","","export function MyReservations() {","  const { usuario } = useAuth();","  const toast = useToast();","  const confirmar = useConfirm();","  const [cancelando, setCancelando] = useState<number | null>(null);","","  const clienteId = usuario?.id ?? 0;","  const { data, loading, error, recargar } = useApi(","    () => Promise.all([getReservasDeCliente(clienteId), getMesas()]),","    [clienteId]","  );","","  const reservas = (data?.[0] ?? []).slice().sort((a, b) => (a.fecha + a.horaInicio).localeCompare(b.fecha + b.horaInicio));","  const numeroDe = (mesaId: number | null) => data?.[1].find((m) => m.id === mesaId)?.numero;","","  const cancelar = async (r: Reserva) => {","    const ok = await confirmar({","      titulo: '¿Cancelar la reserva?',","      texto: `¿Seguro que querés cancelar la reserva del ${formatearFecha(r.fecha)} a las ${r.horaInicio} h? La mesa queda libre para otros clientes.`,","      confirmar: 'Cancelar reserva',","      cancelar: 'Volver'","    });","    if (!ok) return;","","    setCancelando(r.id);","    try {","      await cambiarEstadoReserva(r.id, 'CANCELADA');","      toast.success(`Cancelaste la reserva del ${formatearFecha(r.fecha)}.`);","      recargar();","    } catch (err) {","      toast.error(mensajeDeError(err));","    } finally {","      setCancelando(null);","    }","  };","","  let contenido;","  if (loading) {","    contenido = <SkeletonList rows={3} height={128} />;","  } else if (error) {","    contenido = <EmptyState title=\"No pudimos cargar tus reservas\" text={error} action={<Button onClick={recargar}>Reintentar</Button>} />;","  } else if (reservas.length === 0) {","    contenido = (","      <EmptyState","        title=\"Todavía no tenés reservas\"","        text=\"Cuando reserves una mesa, la vas a ver acá con su fecha, horario y estado.\"","        action={<ButtonLink to=\"/reservar\">Reservá una mesa</ButtonLink>}","      />","    );","  } else {","    contenido = (","      <RecordList>","        {reservas.map((r) => {","          const activa = r.estado === 'PENDIENTE' || r.estado === 'CONFIRMADA';","          const numero = numeroDe(r.mesaId);","          return (","            <RecordCard","              key={r.id}","              arriba={diaDe(r.fecha)}","              abajo={mesDe(r.fecha)}","              apagado={!activa}","              titulo={`${numero ? `Mesa ${numero}` : 'Mesa a asignar'} · ${plural(r.cantidadIntegrantes, 'persona')}`}","              meta={","                <>","                  <span>","                    {formatearFecha(r.fecha)}, de {r.horaInicio} a {deMinutos(aMinutos(r.horaInicio) + r.duracionMin)} h","                  </span>","                  <Badge tono={ESTADO_RESERVA[r.estado].tono}>{ESTADO_RESERVA[r.estado].texto}</Badge>","                  {r.nombre && <span>A nombre de {r.nombre}</span>}","                </>","              }","              acciones={","                activa && (","                  <>","                    <ButtonLink to={`/reservar/${r.id}`} variant=\"secondary\" size=\"sm\">","                      Modificar","                    </ButtonLink>","                    <Button variant=\"danger-quiet\" size=\"sm\" loading={cancelando === r.id} onClick={() => cancelar(r)}>","                      Cancelar","                    </Button>","                  </>","                )","              }","            />","          );","        })}","      </RecordList>","    );","  }","","  return (","    <>","      <PageHeader title=\"Mis reservas\" actions={<ButtonLink to=\"/reservar\">Nueva reserva</ButtonLink>} />","      <div className=\"wrap page\">","        {contenido}","      </div>","    </>","  );","}",""],"frontend/src/context/ConfirmContext.tsx":["import { createContext, useCallback, useContext, useRef, useState, type ReactNode } from 'react';","import { ConfirmDialog, type OpcionesConfirmacion } from '../components/ConfirmDialog/ConfirmDialog';","","type Confirmar = (opciones: OpcionesConfirmacion) => Promise<boolean>;","","const ConfirmContext = createContext<Confirmar | null>(null);","","/** Confirmación antes de eliminar o cancelar: const ok = await confirmar({...}). */","export function ConfirmProvider({ children }: { children: ReactNode }) {","  const [opciones, setOpciones] = useState<OpcionesConfirmacion | null>(null);","  const resolver = useRef<((ok: boolean) => void) | null>(null);","","  const confirmar = useCallback<Confirmar>((nuevas) => {","    setOpciones(nuevas);","    return new Promise<boolean>((resolve) => {","      resolver.current = resolve;","    });","  }, []);","","  const responder = useCallback((ok: boolean) => {","    resolver.current?.(ok);","    resolver.current = null;","    setOpciones(null);","  }, []);","","  return (","    <ConfirmContext.Provider value={confirmar}>","      {children}","      <ConfirmDialog opciones={opciones} onResponder={responder} />","    </ConfirmContext.Provider>","  );","}","","export function useConfirm(): Confirmar {","  const ctx = useContext(ConfirmContext);","  if (!ctx) throw new Error('useConfirm debe usarse dentro de <ConfirmProvider>.');","  return ctx;","}",""]}